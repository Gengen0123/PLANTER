<h1>PLANTER</h1>
<% if user_signed_in? %>
  <p><%= current_user.name %>さんでログイン中です</p>
  <%= button_to "ログアウト",
                destroy_user_session_path,
                method: :delete %>
<% else %>
  <p>植物の成長を記録し、自分だけの図鑑を作成できます。</p>
  <%= link_to "新規登録", new_user_registration_path %>
  <%= link_to "ログイン", new_user_session_path %>
<% end %>
